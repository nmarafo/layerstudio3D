{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nmarafo/layerstudio3D/schema/schema_layerstudio3d_project.json",
  "title": "LayerStudio 3D Project & OKF Recipe Schema (.lasca / .json)",
  "description": "Esquema formal JSON para archivos de proyecto .lasca y recetas ligeras OKF ejecutables mediante window.applyOkfProjectConfig(data) en LayerStudio 3D v3.0.12.",
  "type": "object",
  "properties": {
    "okfVersion": {
      "type": "string",
      "default": "1.3.0",
      "description": "Versión del estándar Open Knowledge Framework."
    },
    "version": {
      "type": "string",
      "default": "3.0.12",
      "description": "Versión del formato de proyecto LayerStudio 3D."
    },
    "modelName": {
      "type": "string",
      "description": "Nombre identificador del proyecto o modelo 3D."
    },
    "presetModel": {
      "type": "string",
      "enum": ["torus", "vase", "gear", "crystal"],
      "description": "Opcional. Si no se incluye 'baseVertices', carga automáticamente uno de los 4 modelos paramétricos integrados antes de aplicar la configuración."
    },
    "maxDimensionMM": {
      "type": "number",
      "minimum": 1,
      "maximum": 10000,
      "description": "Opcional. Escala proporcionalmente el modelo 3D para que su dimensión mayor mida exactamente este valor en milímetros."
    },
    "unit": {
      "type": "string",
      "enum": ["mm", "cm"],
      "default": "mm"
    },
    "constructionMode": {
      "type": "string",
      "enum": ["stacked", "puzzle3d"],
      "default": "stacked",
      "description": "'stacked' para laminado paralelo en 1 eje; 'puzzle3d' para costillas entrelazadas a 90° en 2 ejes."
    },
    "axis": {
      "type": "string",
      "enum": ["x", "y", "z"],
      "default": "z"
    },
    "mode": {
      "type": "string",
      "enum": ["count", "thickness"],
      "default": "count"
    },
    "sliceCount": {
      "type": "integer",
      "minimum": 2,
      "maximum": 200,
      "default": 18
    },
    "thickness": {
      "type": "number",
      "minimum": 0.2,
      "maximum": 200,
      "default": 5
    },
    "puzzleAxes": {
      "type": "string",
      "enum": ["xy", "xz", "yz"],
      "default": "xy"
    },
    "puzzleCountA": {
      "type": "integer",
      "minimum": 2,
      "maximum": 60,
      "default": 6
    },
    "puzzleCountB": {
      "type": "integer",
      "minimum": 2,
      "maximum": 60,
      "default": 6
    },
    "puzzleStartOffsetAMM": {
      "type": "number",
      "default": 0
    },
    "puzzleStartOffsetBMM": {
      "type": "number",
      "default": 0
    },
    "puzzleStartMode": {
      "type": "string",
      "enum": ["start", "symmetric", "shift"],
      "default": "start"
    },
    "puzzleRibOffsetsAMM": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "description": "Mapa { indiceCostilla: offsetMM } para desplazar individualmente costillas de la Serie A."
    },
    "puzzleRibOffsetsBMM": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "description": "Mapa { indiceCostilla: offsetMM } para desplazar individualmente costillas de la Serie B."
    },
    "puzzleMaterialThicknessMM": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 50,
      "default": 4.0
    },
    "puzzleSlotClearanceMM": {
      "type": "number",
      "minimum": -1.0,
      "maximum": 5.0,
      "default": 0.15
    },
    "puzzleSimplifyCutLine": {
      "type": "boolean",
      "default": false,
      "description": "Si es true, simplifica el contorno de corte de las costillas en Puzzle 3D antes de tallar las ranuras de encaje a 90°."
    },
    "puzzleSimplifyMode": {
      "type": "string",
      "enum": ["rdp", "smooth", "bridge", "convex"],
      "default": "rdp"
    },
    "puzzleSimplifyToleranceMM": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 50,
      "default": 1.2
    },
    "puzzleSimplifySmoothPasses": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "default": 1
    },
    "puzzleSelfSupporting": {
      "type": "boolean",
      "default": false,
      "description": "Si es true, las costillas seleccionadas en Puzzle 3D no bajan hasta el suelo y se sostienen solas mediante sus ranuras de encaje a media madera."
    },
    "puzzleSelfSupportTarget": {
      "type": "string",
      "enum": ["outer", "series_b", "series_a", "all", "custom"],
      "default": "outer"
    },
    "puzzleSelfSupportStyle": {
      "type": "string",
      "enum": ["trim_union", "arch", "natural"],
      "default": "trim_union"
    },
    "puzzleSelfSupportClearanceMM": {
      "type": "number",
      "minimum": 0,
      "maximum": 250,
      "default": 22.0
    },
    "puzzleDropUnconnectedIslands": {
      "type": "boolean",
      "default": true
    },
    "puzzleSelfSupportRibs": {
      "type": "object",
      "description": "Mapa de overrides individuales { A: { idx: bool }, B: { idx: bool }, C: { idx: bool } } para costillas autosustentantes."
    },
    "puzzleHideSeriesA": {
      "type": "boolean",
      "default": false
    },
    "puzzleHideSeriesB": {
      "type": "boolean",
      "default": false
    },
    "puzzleHiddenRibs": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "puzzleEngraveEndRibs": {
      "type": "boolean",
      "default": false,
      "description": "En modo Puzzle 3D ('puzzle3d'), lo habitual es grabar la primera y última costilla de los ejes (fachadas exteriores). Si es true, aplica automáticamente la función existente de grabar imagen en lasca a la primera y última costilla de los ejes seleccionados, recortando el grabado al contorno y a las ranuras a 90°."
    },
    "puzzleEngraveEndRibsAxes": {
      "type": "string",
      "enum": ["both", "A", "B"],
      "default": "both",
      "description": "Define en qué ejes del Puzzle 3D se graban automáticamente la primera y última costilla: 'both' (Serie A y Serie B), 'A' (solo Serie A) o 'B' (solo Serie B)."
    },
    "puzzleEngraveEndRibsPreset": {
      "type": "string",
      "enum": ["drawing", "crest", "medallion", "badge"],
      "default": "drawing",
      "description": "Ilustración integrada para el grabado automático en las costillas extremas (primera y última) cuando no se ha subido un bitmap personalizado."
    },
    "puzzleEngraveEndRibsScalePct": {
      "type": "number",
      "minimum": 10,
      "maximum": 250,
      "default": 75,
      "description": "Escala porcentual (10..250%) del grabado de imagen sobre las costillas primera y última de los ejes."
    },
    "puzzleEngraveEndRibsMirrorLast": {
      "type": "boolean",
      "default": true,
      "description": "Si es true, voltea horizontalmente (flipX) el grabado en la última costilla de cada eje para mantener simetría en las fachadas opuestas."
    },
    "sliceImageEngravings": {
      "type": "object",
      "description": "Mapa de grabados de imagen por lasca o costilla individual (ej. 'puzzle_X1', 'puzzle_X8', 'puzzle_Z1', 'puzzle_Z8' o 'stacked_0') utilizando la función de grabar imagen en lasca.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "presetName": { "type": "string", "enum": ["drawing", "crest", "medallion", "badge"] },
          "imageName": { "type": "string" },
          "scalePct": { "type": "number", "default": 75 },
          "offsetXMM": { "type": "number", "default": 0 },
          "offsetYMM": { "type": "number", "default": 0 },
          "rotationDeg": { "type": "number", "default": 0 },
          "flipX": { "type": "boolean", "default": false },
          "detectMode": { "type": "string", "enum": ["smart_drawing", "line_art", "global_threshold"], "default": "smart_drawing" },
          "threshold": { "type": "number", "default": 145 },
          "invert": { "type": "boolean", "default": false },
          "clipToSlice": { "type": "boolean", "default": true }
        }
      }
    },
    "filterSmallIslands": {
      "type": "boolean",
      "default": true
    },
    "minIslandSizeMM": {
      "type": "number",
      "minimum": 0.1,
      "default": 5.0
    },
    "minIslandCriteria": {
      "type": "string",
      "enum": ["max_dim", "min_dim", "area"],
      "default": "max_dim"
    },
    "fillInternalHoles": {
      "type": "boolean",
      "default": true,
      "description": "Elimina huecos internos. En modo 'puzzle3d', cuando el modelo 3D es una cáscara hueca o tiene la base abierta ('Sin Peana', netArea < 0.38 * bboxArea), activa además la reconstrucción automática de la envolvente maciza superior hasta la base (buildSolidRibLoopFromSegments)."
    },
    "fillHolesMode": {
      "type": "string",
      "enum": ["all", "max_size"],
      "default": "all"
    },
    "fillHolesMaxSizeMM": {
      "type": "number",
      "minimum": 0.1,
      "default": 15.0
    },
    "splitModelEnabled": {
      "type": "boolean",
      "default": false
    },
    "splitMode": {
      "type": "string",
      "enum": ["max_size", "grid"],
      "default": "max_size"
    },
    "splitMaxPartWidthMM": {
      "type": "number",
      "default": 300
    },
    "splitMaxPartHeightMM": {
      "type": "number",
      "default": 200
    },
    "splitCols": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 2
    },
    "splitRows": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "default": 2
    },
    "splitJointType": {
      "type": "string",
      "enum": ["dovetail", "puzzle", "finger", "straight"],
      "default": "dovetail"
    },
    "splitJointDepthMM": {
      "type": "number",
      "default": 8
    },
    "splitStaggerLayers": {
      "type": "boolean",
      "default": true
    },
    "includeLabels": {
      "type": "boolean",
      "default": true
    },
    "includeNextSliceGuide": {
      "type": "boolean",
      "default": true
    },
    "includePrevSliceGuide": {
      "type": "boolean",
      "default": false
    },
    "rodCount": {
      "type": "integer",
      "enum": [0, 1, 2, 3],
      "default": 0
    },
    "rodDiameter": {
      "type": "number",
      "default": 4.0
    },
    "slicerFrameEnabled": {
      "type": "boolean",
      "default": false
    },
    "tabsEnabled": {
      "type": "boolean",
      "default": false
    },
    "nestingEnabled": {
      "type": "boolean",
      "default": false
    },
    "boardWidthMM": {
      "type": "number",
      "default": 600
    },
    "boardHeightMM": {
      "type": "number",
      "default": 400
    },
    "nestSpacingMM": {
      "type": "number",
      "default": 3
    },
    "nestMarginMM": {
      "type": "number",
      "default": 5
    },
    "nestAllowRotate": {
      "type": "boolean",
      "default": true
    },
    "nestUseInnerHoles": {
      "type": "boolean",
      "default": true
    },
    "nestClipOversized": {
      "type": "boolean",
      "default": false
    },
    "carrierEnabled": {
      "type": "boolean",
      "default": false
    },
    "carrierWidthMM": {
      "type": "number",
      "default": 1220
    },
    "carrierHeightMM": {
      "type": "number",
      "default": 900
    },
    "dimsMM": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "selectedIndices": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "baseVertices": {
      "type": "array",
      "items": { "type": "number" },
      "description": "Coordenadas planas [x0,y0,z0, x1,y1,z1, ...] de los triángulos de la malla 3D normalizada."
    }
  }
}
